# ── Opportunity Engine — Environment Variables ──────────────────────────────
# Copy this file to .env and fill in the values.

# Telegram
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
TELEGRAM_CHANNEL_ID=@my_opportunity_alerts

# Razorpay (for paid-tier subscriptions)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Gold Price API  — get a free key at https://www.goldapi.io/
GOLD_API_KEY=goldapi-xxxxxxxxxxxxx

# Amazon Associates affiliate tag
AMAZON_AFFILIATE_TAG=myaff-21

# Flipkart Affiliate
FLIPKART_AFFILIATE_ID=myflipkartid
FLIPKART_AFFILIATE_TOKEN=myflipkarttoken

# ── Scanner thresholds (optional — defaults are sensible) ───────────────────
SGB_MIN_DISCOUNT_PCT=3.0
TENDER_MIN_VALUE=100000
TENDER_MAX_VALUE=5000000
PROPERTY_MIN_DISCOUNT_PCT=10.0
JOB_MIN_MATCH_SCORE=60
DEAL_MIN_PRICE_DROP_PCT=20.0

# ── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=opportunity_engine.log
